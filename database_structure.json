    "create_sql": "CREATE TABLE `chat_message` (\n  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '消息ID（主键）',\n  `session_id` varchar(100) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '会话ID',\n  `role` varchar(20) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '消息角色（user/assistant/system）',\n  `message_format` varchar(50) COLLATE utf8mb4_unicode_ci DEFAULT 'default' COMMENT '消息格式类型：default/coze/ronghui',\n  `content` text COLLATE utf8mb4_unicode_ci COMMENT '消息内容',\n  `raw_content` text COLLATE utf8mb4_unicode_ci COMMENT '原始响应内容（JSON格式，用于调试）',\n  `files` text COLLATE utf8mb4_unicode_ci COMMENT '附件文件信息（JSON格式）',\n  `thought` text COLLATE utf8mb4_unicode_ci COMMENT '思考过程(AI的思维链)',\n  `tasks` longtext COLLATE utf8mb4_unicode_ci COMMENT '任务详情(JSON数组,包含所有任务执行过程)',\n  `plan` text COLLATE utf8mb4_unicode_ci COMMENT '计划信息(JSON对象,包含计划标题和步骤)',\n  `metadata` longtext COLLATE utf8mb4_unicode_ci COMMENT '其他元数据(JSON对象,存储额外信息)',\n  `create_time` datetime DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',\n  `yn` tinyint DEFAULT '0' COMMENT '逻辑删除（0-未删除，1-已删除）',\n  PRIMARY KEY (`id`),\n  KEY `idx_session_id` (`session_id`),\n  KEY `idx_create_time` (`create_time`)\n) ENGINE=InnoDB AUTO_INCREMENT=488 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='聊天消息表'",
