  "chat_model_schema": {
    "create_sql": "CREATE TABLE `chat_model_schema` (\n  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键',\n  `model_code` varchar(200) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '模型编码',\n  `column_id` varchar(1000) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '字段唯一ID',\n  `column_name` varchar(200) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '字段中文名',\n  `column_comment` varchar(1000) COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '字段描述',\n  `few_shot` text COLLATE utf8mb4_unicode_ci COMMENT '值枚举逗号分隔',\n  `data_type` varchar(20) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '字段值类型',\n  `synonyms` varchar(300) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '同义词',\n  `vector_uuid` varchar(400) COLLATE utf8mb4_unicode_ci DEFAULT NULL COMMENT '向量库数据id',\n  `default_recall` tinyint DEFAULT '0' COMMENT '默认召回',\n  `analyze_suggest` tinyint DEFAULT '0' COMMENT '分析建议0可选，-1禁止用于分析维度，1建议',\n  `yn` tinyint DEFAULT '0' COMMENT '逻辑删除（0-未删除，1-已删除）',\n  PRIMARY KEY (`id`),\n  KEY `idx_model_code` (`model_code`),\n  KEY `idx_column_name` (`column_name`)\n) ENGINE=InnoDB AUTO_INCREMENT=2269 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='数据模型表信息'",
