  "agent_provider": {
    "create_sql": "CREATE TABLE `agent_provider` (\n  `id` bigint NOT NULL AUTO_INCREMENT COMMENT '主键ID',\n  `user_id` bigint NOT NULL COMMENT '【已废弃】保留字段，用于向后兼容',\n  `creator_id` bigint NOT NULL COMMENT '创建者ID，用于\"我的智能体\"筛选',\n  `provider_type` varchar(50) NOT NULL COMMENT '平台类型: default/coze/ronghui',\n  `provider_name` varchar(10) NOT NULL COMMENT '应用名称（最多10个字）',\n  `description` text COMMENT '智能体简介（最多500字符）',\n  `icon` varchar(500) DEFAULT NULL COMMENT '智能体图标URL',\n  `api_endpoint` varchar(500) DEFAULT NULL COMMENT 'API请求地址（default类型为空）',\n  `api_key` varchar(500) DEFAULT NULL COMMENT 'API密钥（明文存储，default类型为空）',\n  `bot_id` varchar(100) DEFAULT NULL COMMENT 'Coze平台的Bot ID（仅coze类型必填）',\n  `is_default` tinyint(1) DEFAULT '0' COMMENT '是否为该用户的默认智能体（0-否 1-是）',\n  `status` tinyint(1) DEFAULT '1' COMMENT '状态（0-禁用 1-启用）',\n  `is_public` tinyint(1) DEFAULT '1' COMMENT '公开状态：1-所有用户可见，0-仅创建者可见',\n  `usage_count` int DEFAULT '0' COMMENT '使用次数统计',\n  `category` varchar(50) DEFAULT NULL COMMENT '分类标签（教育/新零售/消费等）',\n  `extra_config` json DEFAULT NULL COMMENT '额外配置（JSON格式，存储平台特有参数）',\n  `create_time` datetime DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',\n  `update_time` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',\n  `workspace_id` varchar(50) DEFAULT NULL COMMENT '通义点金的工作空间ID（仅tongyi类型使用）',\n  `tenant_id` varchar(50) DEFAULT NULL COMMENT '租户ID（仅ronghui类型使用）',\n  `login_user_id` varchar(50) DEFAULT NULL COMMENT '登录用户ID（仅ronghui类型使用）',\n  `login_dept_id` varchar(50) DEFAULT NULL COMMENT '登录部门ID（仅ronghui类型使用）',\n  `login_username` varchar(50) DEFAULT NULL COMMENT '登录用户名（仅ronghui类型使用）',\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uk_creator_provider_name` (`creator_id`,`provider_name`),\n  KEY `idx_user_id` (`user_id`),\n  KEY `idx_provider_type` (`provider_type`),\n  KEY `idx_bot_id` (`bot_id`),\n  KEY `idx_creator_id` (`creator_id`),\n  KEY `idx_is_public` (`is_public`),\n  KEY `idx_category` (`category`)\n) ENGINE=InnoDB AUTO_INCREMENT=8 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='智能体服务商配置表'",
