# ============================================
# 华创证券智能体底座 - Docker环境变量配置
# ============================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 修改下方配置项的值
# 3. 运行 docker-compose up -d 启动服务
# ============================================

# ============================================
# 数据库配置
# ============================================
DB_ROOT_PASSWORD=YourRootPassword123!
DB_NAME=genie_db
DB_USER=genie
DB_PASSWORD=YourDbPassword123!

# ============================================
# LLM配置
# ============================================
# DeepSeek配置示例
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 通义千问配置示例（如需使用，取消注释并填写）
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# LLM_MODEL=qwen-turbo

# ============================================
# JWT安全配置
# ============================================
# 注意：JWT密钥长度至少32字符，建议使用随机字符串
JWT_SECRET=your-jwt-secret-key-at-least-32-characters-long-change-this

# ============================================
# 服务端口配置
# ============================================
# 注意：生产环境建议使用默认端口，避免端口冲突
BACKEND_PORT=8080
FRONTEND_PORT=80
TOOL_PORT=8000
CLIENT_PORT=8188

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO

# ============================================
# 外部智能体平台配置（可选）
# ============================================
# Coze平台配置
# COZE_API_KEY=your_coze_api_key
# COZE_BASE_URL=https://api.coze.cn/v3

# 通义千问平台配置
# TONGYI_API_KEY=your_tongyi_api_key

# 融汇智能平台配置
# RONGHUI_API_KEY=your_ronghui_api_key
# RONGHUI_BASE_URL=https://api.ronghui.ai

# ============================================
# 高级配置（一般无需修改）
# ============================================
# 代码执行器超时时间（秒）
CODE_TIMEOUT=30

# 搜索结果数量
SEARCH_MAX_RESULTS=10

# 文件上传大小限制（MB）
FILE_UPLOAD_MAX_SIZE_MB=10
